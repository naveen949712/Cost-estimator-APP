@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using System.IO
@using System.Text
@using System.Text.RegularExpressions
@using CsvHelper
@using CsvHelper.Configuration
@using ClosedXML.Excel
@using Cost_Estimator_App.Models
@using Cost_Estimator_App.Services
@inject AzurePricingService PricingService
@inject IJSRuntime JS

<PageTitle>Cost Estimator App</PageTitle>

<div class="container-fluid mt-3">
    <h3 class="mb-3">Azure Cost Estimator App</h3>

    <!-- Controls Card (Preferences & Runtime) -->
    <div class="card mb-3 shadow-sm border-0 bg-white rounded-3">
        <div class="card-body p-4">
            <div class="row g-4 align-items-start">
                <!-- 1. File Upload -->
                <div class="col-lg-4 col-md-12">
                    <label class="form-label fw-bold text-secondary text-uppercase small mb-2">
                        <span class="badge bg-primary me-1">1</span> Upload Inventory
                    </label>
                    <InputFile OnChange="HandleFileSelected" class="form-control shadow-sm" accept=".csv, .xlsx" />
                    <div class="form-text text-muted small mt-1">
                        Accepted: <code>.csv</code>, <code>.xlsx</code> (Headers: VmName, Env, CPU, RAM, OSDisk, DataDisk, Region, OS, SqlEdition)
                    </div>
                </div>

                <!-- 2. Preferences & Runtime -->
                <div class="col-lg-5 col-md-12">
                    <label class="form-label fw-bold text-secondary text-uppercase small mb-2">
                        <span class="badge bg-primary me-1">2</span> Preferences & Runtime
                    </label>
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1 text-truncate w-100">Architecture</label>
                            <select class="form-select form-select-sm shadow-sm" @bind="selectedProcessor">
                                <option value="Any">Original</option>
                                <option value="Intel">Prefer Intel</option>
                                <option value="AMD">Prefer AMD</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1 text-truncate w-100">Pricing Model</label>
                            <select class="form-select form-select-sm shadow-sm" @bind="selectedPricingModel">
                                <option value="All">Compare All</option>
                                <option value="PAYG">PAYG Only</option>
                                <option value="1Yr">1-Year RI</option>
                                <option value="3Yr">3-Year RI</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1 text-truncate w-100">Hours / Month</label>
                            <input type="number" class="form-control form-control-sm shadow-sm" min="1" max="744" @bind="monthlyOperatingHours" />
                        </div>
                    </div>
                </div>

                <!-- 3. Dual AHB Toggles -->
                <div class="col-lg-3 col-md-12">
                    <label class="form-label fw-bold text-secondary text-uppercase small mb-2">
                        <span class="badge bg-primary me-1">3</span> Hybrid Benefit (AHB)
                    </label>
                    <div class="p-2 border rounded-3 bg-light shadow-sm d-flex justify-content-around align-items-center" style="min-height: 52px;">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="ahbOsSwitch" 
                                   checked="@enableOsAhb" 
                                   @onchange="ToggleOsAhb" />
                            <label class="form-check-label fw-semibold small ms-1" for="ahbOsSwitch">Win / OS</label>
                        </div>
                        <div class="vr mx-1"></div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="ahbSqlSwitch" 
                                   checked="@enableSqlAhb" 
                                   @onchange="ToggleSqlAhb" />
                            <label class="form-check-label fw-semibold small ms-1" for="ahbSqlSwitch">SQL Server</label>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-3 text-muted opacity-25" />

            <!-- Action Toolbar -->
            <div class="d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    @(rawItems.Count > 0 ? $"{rawItems.Count} VM(s) loaded. Operating at {monthlyOperatingHours} hrs/mo." : "Upload an inventory file to begin.")
                </span>
                <button class="btn btn-primary px-4 py-2 shadow-sm fw-semibold" 
                        @onclick="RunEstimation" 
                        disabled="@(isLoading || rawItems.Count == 0)">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Calculating Estimates...</span>
                    }
                    else
                    {
                        <span>Calculate Estimate</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Collapsible Landing Zone & Shared Hub Services -->
    <div class="card mb-4 shadow-sm border-0 bg-white rounded-3">
        <div class="card-header bg-light py-2 px-3 border-0 d-flex justify-content-between align-items-center">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="lzMasterSwitch" @bind="lzConfig.MasterEnable" />
                <label class="form-check-label fw-bold text-secondary" for="lzMasterSwitch">
                    Include Landing Zone & Shared Hub Infrastructure
                </label>
            </div>
            <button class="btn btn-sm btn-link text-decoration-none text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#lzPanelCollapse">
                <i class="bi bi-chevron-expand"></i> Details
            </button>
        </div>

        <div class="collapse @(lzConfig.MasterEnable ? "show" : "")" id="lzPanelCollapse">
            <div class="card-body p-3 bg-white">
                <div class="row g-3">
                    <!-- 1. Azure Firewall -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkFw" @bind="lzConfig.EnableFirewall" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkFw">Azure Firewall</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Tier</label>
                            <select class="form-select form-select-sm" @bind="lzConfig.FirewallTier" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableFirewall)">
                                <option value="Standard">Standard (~$912.50/mo)</option>
                                <option value="Premium">Premium (~$1,277.50/mo)</option>
                                <option value="Basic">Basic (~$292.00/mo)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 2. Azure VPN Gateway (AZ Resilient SKUs) -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkVpn" @bind="lzConfig.EnableVpnGateway" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkVpn">Azure VPN Gateway</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Availability Zone SKU</label>
                            <select class="form-select form-select-sm" @bind="lzConfig.VpnSku" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableVpnGateway)">
                                <option value="VpnGw1AZ">VpnGw1AZ (~$153.30/mo)</option>
                                <option value="VpnGw2AZ">VpnGw2AZ (~$394.20/mo)</option>
                                <option value="VpnGw3AZ">VpnGw3AZ (~$1,007.40/mo)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 3. Application Gateway (Standard_v2 / WAF_v2) -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkAppGw" @bind="lzConfig.EnableAppGateway" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkAppGw">Application Gateway v2</label>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Tier</label>
                                    <select class="form-select form-select-sm" @bind="lzConfig.AppGwTier" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableAppGateway)">
                                        <option value="Standard_v2">Standard_v2</option>
                                        <option value="WAF_v2">WAF_v2</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Capacity Units</label>
                                    <input type="number" class="form-control form-control-sm" min="1" max="20" @bind="lzConfig.AppGwCapacityUnits" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableAppGateway)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Azure Bastion -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkBastion" @bind="lzConfig.EnableBastion" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkBastion">Azure Bastion</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Tier</label>
                            <select class="form-select form-select-sm" @bind="lzConfig.BastionTier" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableBastion)">
                                <option value="Standard">Standard (~$211.70/mo)</option>
                                <option value="Basic">Basic (~$138.70/mo)</option>
                                <option value="Developer">Developer (~$35.00/mo)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 5. Azure Backup -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkBackup" @bind="lzConfig.EnableBackup" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkBackup">Azure Backup (VM Vault)</label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Auto-sizes @results.Count VM(s) instances + storage vault retention (~$10/instance + $0.022/GB).
                            </small>
                        </div>
                    </div>

                    <!-- 6. Microsoft Defender for Cloud -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkDefender" @bind="lzConfig.EnableDefender" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkDefender">Defender for Cloud</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Servers Plan</label>
                            <select class="form-select form-select-sm" @bind="lzConfig.DefenderPlan" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableDefender)">
                                <option value="Plan 2">Plan 2 ($15.00/server/mo)</option>
                                <option value="Plan 1">Plan 1 ($5.00/server/mo)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 7. Azure Key Vault -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkKv" @bind="lzConfig.EnableKeyVault" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkKv">Azure Key Vault</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Tier</label>
                            <select class="form-select form-select-sm" @bind="lzConfig.KeyVaultTier" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableKeyVault)">
                                <option value="Standard">Standard (~$6.00/mo)</option>
                                <option value="Premium">Premium HSM (~$150.00/mo)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 8. Azure DDoS Protection -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkDdos" @bind="lzConfig.EnableDdos" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkDdos">DDoS Protection</label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Network Protection Plan (~$2,944.00/month covers up to 100 public IPs).
                            </small>
                        </div>
                    </div>

                    <!-- 9. Public IP Addresses -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkPip" @bind="lzConfig.EnablePublicIps" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkPip">Public IP Addresses</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Count</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="50" @bind="lzConfig.PublicIpCount" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnablePublicIps)" />
                            <small class="text-muted">Standard static IPv4 (~$3.65/IP/mo)</small>
                        </div>
                    </div>

                    <!-- 10. Private Endpoints -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkPe" @bind="lzConfig.EnablePrivateEndpoints" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkPe">Private Endpoints</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Count</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="50" @bind="lzConfig.PrivateEndpointCount" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnablePrivateEndpoints)" />
                            <small class="text-muted">~$7.30/endpoint/month</small>
                        </div>
                    </div>

                    <!-- 11. NAT Gateway -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkNat" @bind="lzConfig.EnableNatGateway" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkNat">NAT Gateway</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Count</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="10" @bind="lzConfig.NatGatewayCount" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableNatGateway)" />
                            <small class="text-muted">~$32.85/gateway/month</small>
                        </div>
                    </div>

                    <!-- 12. DNS Private Resolver -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkDns" @bind="lzConfig.EnableDnsResolver" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkDns">DNS Private Resolver</label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                1 Inbound + 1 Outbound resolver endpoints (~$160.60/month).
                            </small>
                        </div>
                    </div>

                    <!-- 13. Azure Site Recovery (ASR) -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkAsr" @bind="lzConfig.EnableAsr" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkAsr">Azure Site Recovery</label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Disaster Recovery license ($25.00/month per VM) for all @results.Count VM(s).
                            </small>
                        </div>
                    </div>

                    <!-- 14. Azure Monitor (Log Analytics) -->
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkMon" @bind="lzConfig.EnableMonitor" disabled="@(!lzConfig.MasterEnable)" />
                                <label class="form-check-label fw-bold small" for="chkMon">Azure Monitor (Logs)</label>
                            </div>
                            <label class="form-label small text-muted mb-1">Ingestion (GB / Mo)</label>
                            <input type="number" class="form-control form-control-sm" min="5" max="1000" @bind="lzConfig.MonitorDataIngestionGb" disabled="@(!lzConfig.MasterEnable || !lzConfig.EnableMonitor)" />
                            <small class="text-muted">First 5 GB free + $2.30/GB overage</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Messages -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusMessage.StartsWith("Error") ? "alert-danger" : "alert-info")">
            @statusMessage
        </div>
    }

    <!-- Executive Monthly Cost Summary Table -->
    @if (results.Count > 0)
    {
        <div class="card mb-3 shadow-sm border-0 bg-white rounded-3">
            <div class="card-header bg-light py-2 px-3 border-0 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-secondary">
                    <i class="bi bi-table me-1"></i> Executive Monthly Cost Summary
                </h6>
                <span class="badge bg-secondary">Currency: USD</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 align-middle">
                        <thead class="table-light">
                            <tr class="text-secondary small text-uppercase">
                                <th style="width: 70px;" class="text-center">Sl No</th>
                                <th>Service Name</th>
                                <th class="text-end" style="width: 220px;">PAYG</th>
                                <th class="text-end" style="width: 220px;">1 YR RI Model</th>
                                <th class="text-end" style="width: 220px;">3 YR RI Model</th>
                                <th style="width: 280px;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 1. Compute -->
                            <tr>
                                <td class="text-center text-muted">1</td>
                                <td class="fw-semibold">Virtual Machines (Compute)</td>
                                <td class="text-end">$@totalComputePayg.ToString("N2")</td>
                                <td class="text-end">$@totalCompute1Yr.ToString("N2")</td>
                                <td class="text-end">$@totalCompute3Yr.ToString("N2")</td>
                                <td class="small text-muted">Scaled to @monthlyOperatingHours hrs/mo</td>
                            </tr>
                            <!-- 2. Disks -->
                            <tr>
                                <td class="text-center text-muted">2</td>
                                <td class="fw-semibold">Managed Disks (OS & Data)</td>
                                <td class="text-end">$@totalStorage.ToString("N2")</td>
                                <td class="text-end">$@totalStorage.ToString("N2")</td>
                                <td class="text-end">$@totalStorage.ToString("N2")</td>
                                <td class="small text-muted">Fixed monthly rate</td>
                            </tr>
                            <!-- 3. OS Licensing -->
                            <tr>
                                <td class="text-center text-muted">3</td>
                                <td class="fw-semibold">OS Licensing</td>
                                <td class="text-end">$@totalOsLicense.ToString("N2")</td>
                                <td class="text-end">$@totalOsLicense.ToString("N2")</td>
                                <td class="text-end">$@totalOsLicense.ToString("N2")</td>
                                <td class="small text-muted">@(enableOsAhb ? "AHB Applied ($0)" : "PAYG license")</td>
                            </tr>
                            <!-- 4. SQL Licensing -->
                            <tr>
                                <td class="text-center text-muted">4</td>
                                <td class="fw-semibold">Database Licensing (SQL Server)</td>
                                <td class="text-end">$@totalSqlLicense.ToString("N2")</td>
                                <td class="text-end">$@totalSqlLicense.ToString("N2")</td>
                                <td class="text-end">$@totalSqlLicense.ToString("N2")</td>
                                <td class="small text-muted">@(enableSqlAhb ? "AHB Applied ($0)" : "PAYG license")</td>
                            </tr>

                            <!-- 5. Consolidated Landing Zone Resources -->
                            @if (lzConfig.MasterEnable && totalLandingZoneMonthly > 0)
                            {
                                <tr>
                                    <td class="text-center text-muted">5</td>
                                    <td class="fw-semibold">Landing zone resources</td>
                                    <td class="text-end">$@totalLandingZoneMonthly.ToString("N2")</td>
                                    <td class="text-end">$@totalLandingZoneMonthly.ToString("N2")</td>
                                    <td class="text-end">$@totalLandingZoneMonthly.ToString("N2")</td>
                                    <td class="small text-muted">Consolidated shared hub services</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-dark fw-bold">
                            <tr>
                                <td colspan="2" class="text-end text-uppercase">Total Cost</td>
                                <td class="text-end text-warning fs-6">$@grandTotalPayg.ToString("N2")</td>
                                <td class="text-end text-success fs-6">$@grandTotal1Yr.ToString("N2")</td>
                                <td class="text-end text-info fs-6">$@grandTotal3Yr.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Considerations and Assumptions Note Card -->
        <div class="card mb-4 border-0 shadow-sm rounded-3 bg-light">
            <div class="card-body p-3">
                <h6 class="fw-bold text-dark mb-2">
                    <i class="bi bi-info-circle-fill text-primary me-1"></i> Considerations & Assumptions
                </h6>
                <ul class="mb-0 small text-secondary ps-3">
                    <li><strong>Operating Schedule:</strong> Pay-As-You-Go (PAYG) compute and core licenses are calculated based on <strong>@monthlyOperatingHours hours/month</strong>.</li>
                    <li><strong>Commitment Models:</strong> 1-Year and 3-Year Reserved Instances (RI) apply strictly to compute infrastructure and require fixed commitments.</li>
                    <li><strong>Storage Mapping:</strong> Non-production (Dev/UAT/Test) environments map to Standard SSD (E-series); Production environments map to Premium SSD (P-series). Storage costs remain flat monthly charges.</li>
                    <li><strong>Licensing:</strong> OS license fees reflect @(enableOsAhb ? "Azure Hybrid Benefit (AHB applied, $0.00)" : "PAYG core licensing"). SQL Server reflects @(enableSqlAhb ? "Azure Hybrid Benefit (AHB applied, $0.00)" : "standard core licensing with a minimum 4-core billing rule").</li>
                    <li><strong>SKU Selection:</strong> Workloads are evaluated dynamically across D-series, E-series, and M-series families, prioritizing the candidate with the lowest overall monthly cost (Compute + Licensing + Storage).</li>
                    @if (lzConfig.MasterEnable)
                    {
                        <li><strong>Landing Zone Resources:</strong> Shared hub infrastructure components are consolidated into a single line item in the executive summary, with individual itemization detailed on the dedicated sheet.</li>
                    }
                </ul>
            </div>
        </div>

        <!-- Action / Direct Download Buttons -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Estimation Breakdown (Inventory Details)</h5>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-success shadow-sm" @onclick="ExportToExcel">
                    <i class="bi bi-file-earmark-excel me-1"></i> Download Excel (.xlsx)
                </button>
                <button type="button" class="btn btn-outline-primary shadow-sm" @onclick="ExportToCsv">
                    <i class="bi bi-file-earmark-text me-1"></i> Download CSV (.csv)
                </button>
            </div>
        </div>

        <!-- Detailed Inventory Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>VM / Hostname</th>
                        <th>Env</th>
                        <th class="table-light text-dark">Source CPU</th>
                        <th class="table-light text-dark">Source RAM (GB)</th>
                        <th>Azure SKU</th>
                        <th>Azure CPU</th>
                        <th>Azure RAM (GB)</th>
                        <th>Region</th>
                        <th>OS</th>
                        <th>SQL</th>
                        <th>Qty</th>

                        @if (selectedPricingModel == "All" || selectedPricingModel == "PAYG") { <th>Compute PAYG / Mo</th> }
                        @if (selectedPricingModel == "All" || selectedPricingModel == "1Yr") { <th>Compute 1-Yr RI / Mo</th> }
                        @if (selectedPricingModel == "All" || selectedPricingModel == "3Yr") { <th>Compute 3-Yr RI / Mo</th> }

                        <th class="table-secondary text-dark">OS disk sku</th>
                        <th class="table-secondary text-dark">OS disk cost</th>
                        <th class="table-secondary text-dark">Data disk sku</th>
                        <th class="table-secondary text-dark">Data disk cost</th>
                        <th class="table-secondary text-dark fw-bold">Total disk cost</th>

                        <th class="table-info text-dark">OS Lic / Mo</th>
                        <th class="table-warning text-dark">SQL Lic / Mo</th>

                        @if (selectedPricingModel == "All" || selectedPricingModel == "PAYG") { <th class="table-primary text-dark">Total PAYG / Mo</th> }
                        @if (selectedPricingModel == "All" || selectedPricingModel == "1Yr") { <th class="table-success text-dark">Total 1-Yr / Mo</th> }
                        @if (selectedPricingModel == "All" || selectedPricingModel == "3Yr") { <th class="table-warning text-dark">Total 3-Yr / Mo</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in results)
                    {
                        <tr>
                            <td>@row.VmName</td>
                            <td>
                                <span class="badge @(row.Environment.StartsWith("P", StringComparison.OrdinalIgnoreCase) ? "bg-danger" : "bg-info text-dark")">
                                    @row.Environment
                                </span>
                            </td>
                            <td class="table-light text-dark text-center">
                                @(row.SourceCpu > 0 ? $"{row.SourceCpu}" : "-")
                            </td>
                            <td class="table-light text-dark text-center">
                                @(row.SourceRamGb > 0 ? $"{row.SourceRamGb}" : "-")
                            </td>
                            <td><code>@row.SkuName</code></td>
                            <td class="text-center fw-bold">@row.TargetCpu</td>
                            <td class="text-center fw-bold">@row.TargetRamGb</td>
                            <td>@row.Region</td>
                            <td>
                                <span class="badge @(row.DetectedOs == "Windows" ? "bg-primary" : (row.DetectedOs == "RHEL" ? "bg-danger" : (row.DetectedOs.StartsWith("SUSE") ? "bg-success" : "bg-secondary")))">
                                    @row.DetectedOs
                                </span>
                            </td>
                            <td>
                                @if (row.SqlEdition != "-")
                                {
                                    <span class="badge bg-dark">@row.SqlEdition</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@row.Quantity</td>

                            @if (selectedPricingModel == "All" || selectedPricingModel == "PAYG")
                            {
                                <td>$@row.ComputePaygMonthly.ToString("N2")</td>
                            }
                            @if (selectedPricingModel == "All" || selectedPricingModel == "1Yr")
                            {
                                <td>$@row.ComputeReserved1YrMonthly.ToString("N2")</td>
                            }
                            @if (selectedPricingModel == "All" || selectedPricingModel == "3Yr")
                            {
                                <td>$@row.ComputeReserved3YrMonthly.ToString("N2")</td>
                            }

                            <td class="table-secondary text-dark text-nowrap">
                                <small>@row.RecommendedOsDisk</small>
                            </td>
                            <td class="table-secondary fw-bold text-dark text-end">
                                $@row.OsDiskMonthlyCost.ToString("N2")
                            </td>
                            <td class="table-secondary text-dark text-nowrap">
                                <small>@row.RecommendedDataDisk</small>
                            </td>
                            <td class="table-secondary fw-bold text-dark text-end">
                                $@row.DataDiskMonthlyCost.ToString("N2")
                            </td>
                            <td class="table-secondary fw-bold text-dark text-end border-start">
                                $@((row.OsDiskMonthlyCost + row.DataDiskMonthlyCost).ToString("N2"))
                            </td>

                            <td class="table-info fw-bold text-dark">
                                @(row.OsLicenseMonthlyCost > 0 ? $"${row.OsLicenseMonthlyCost:N2}" : "$0.00")
                            </td>
                            <td class="table-warning fw-bold text-dark">
                                @(row.SqlLicenseMonthlyCost > 0 ? $"${row.SqlLicenseMonthlyCost:N2}" : "$0.00")
                            </td>

                            @if (selectedPricingModel == "All" || selectedPricingModel == "PAYG")
                            {
                                <td class="table-primary fw-bold text-dark">$@row.TotalPaygMonthly.ToString("N2")</td>
                            }
                            @if (selectedPricingModel == "All" || selectedPricingModel == "1Yr")
                            {
                                <td class="table-success fw-bold text-dark">$@row.TotalReserved1YrMonthly.ToString("N2")</td>
                            }
                            @if (selectedPricingModel == "All" || selectedPricingModel == "3Yr")
                            {
                                <td class="table-warning fw-bold text-dark">$@row.TotalReserved3YrMonthly.ToString("N2")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string selectedProcessor = "Any";
    private string selectedPricingModel = "All";
    private int monthlyOperatingHours = 730;
    private bool enableOsAhb = false;
    private bool enableSqlAhb = false;
    private bool isLoading = false;
    private string statusMessage = "";

    private LandingZoneConfig lzConfig = new();
    private List<InventoryItem> rawItems = new();
    private List<CostEstimateResult> results = new();

    private decimal totalComputePayg => results.Sum(r => r.ComputePaygMonthly);
    private decimal totalCompute1Yr => results.Sum(r => r.ComputeReserved1YrMonthly);
    private decimal totalCompute3Yr => results.Sum(r => r.ComputeReserved3YrMonthly);
    private decimal totalOsDisk => results.Sum(r => r.OsDiskMonthlyCost);
    private decimal totalDataDisk => results.Sum(r => r.DataDiskMonthlyCost);
    private decimal totalStorage => totalOsDisk + totalDataDisk;
    private decimal totalOsLicense => results.Sum(r => r.OsLicenseMonthlyCost);
    private decimal totalSqlLicense => results.Sum(r => r.SqlLicenseMonthlyCost);

    private decimal totalLandingZoneMonthly
    {
        get
        {
            if (!lzConfig.MasterEnable) return 0m;
            decimal total = 0m;
            int vmCount = results.Sum(r => r.Quantity);
            decimal storage = results.Sum(r => r.SourceOsDiskGb + r.SourceDataDiskGb);

            if (lzConfig.EnableFirewall) total += PricingService.CalculateFirewallCost(lzConfig.FirewallTier).MonthlyCost;
            if (lzConfig.EnableVpnGateway) total += PricingService.CalculateVpnGatewayCost(lzConfig.VpnSku).MonthlyCost;
            if (lzConfig.EnableAppGateway) total += PricingService.CalculateAppGatewayCost(lzConfig.AppGwTier, lzConfig.AppGwCapacityUnits).MonthlyCost;
            if (lzConfig.EnableBastion) total += PricingService.CalculateBastionCost(lzConfig.BastionTier).MonthlyCost;
            if (lzConfig.EnableBackup) total += PricingService.CalculateBackupCost(vmCount, storage).MonthlyCost;
            if (lzConfig.EnableDefender) total += PricingService.CalculateDefenderCost(vmCount, lzConfig.DefenderPlan).MonthlyCost;
            if (lzConfig.EnableKeyVault) total += PricingService.CalculateKeyVaultCost(lzConfig.KeyVaultTier).MonthlyCost;
            if (lzConfig.EnableDdos) total += PricingService.CalculateDdosCost().MonthlyCost;
            if (lzConfig.EnablePublicIps) total += PricingService.CalculatePublicIpCost(lzConfig.PublicIpCount).MonthlyCost;
            if (lzConfig.EnablePrivateEndpoints) total += PricingService.CalculatePrivateEndpointCost(lzConfig.PrivateEndpointCount).MonthlyCost;
            if (lzConfig.EnableNatGateway) total += PricingService.CalculateNatGatewayCost(lzConfig.NatGatewayCount).MonthlyCost;
            if (lzConfig.EnableDnsResolver) total += PricingService.CalculateDnsResolverCost().MonthlyCost;
            if (lzConfig.EnableAsr) total += PricingService.CalculateAsrCost(vmCount).MonthlyCost;
            if (lzConfig.EnableMonitor) total += PricingService.CalculateMonitorCost(lzConfig.MonitorDataIngestionGb).MonthlyCost;

            return total;
        }
    }

    private decimal grandTotalPayg => results.Sum(r => r.TotalPaygMonthly) + totalLandingZoneMonthly;
    private decimal grandTotal1Yr => results.Sum(r => r.TotalReserved1YrMonthly) + totalLandingZoneMonthly;
    private decimal grandTotal3Yr => results.Sum(r => r.TotalReserved3YrMonthly) + totalLandingZoneMonthly;

    private async Task ToggleOsAhb(ChangeEventArgs e)
    {
        enableOsAhb = (bool)(e.Value ?? false);
        if (results.Count > 0) await RunEstimation();
    }

    private async Task ToggleSqlAhb(ChangeEventArgs e)
    {
        enableSqlAhb = (bool)(e.Value ?? false);
        if (results.Count > 0) await RunEstimation();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            rawItems.Clear();
            results.Clear();

            var file = e.File;
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            if (extension == ".csv") ParseCsv(memoryStream);
            else if (extension == ".xlsx") ParseExcel(memoryStream);
            else
            {
                statusMessage = "Error: Unsupported file format. Please upload a .csv or .xlsx file.";
                return;
            }

            statusMessage = $"Successfully loaded {rawItems.Count} items from {file.Name}. Ready to calculate.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error parsing file: {ex.Message}";
        }
    }

    private void ParseCsv(Stream stream)
    {
        using var reader = new StreamReader(stream);
        using var csv = new CsvReader(reader, new CsvConfiguration(CultureInfo.InvariantCulture)
        {
            HeaderValidated = null,
            MissingFieldFound = null,
            PrepareHeaderForMatch = args => Regex.Replace(args.Header.ToLowerInvariant(), @"[\s_]+", "")
        });

        var records = csv.GetRecords<dynamic>().ToList();
        foreach (var rec in records)
        {
            var dict = (IDictionary<string, object>)rec;

            string GetVal(params string[] aliases)
            {
                foreach (var alias in aliases)
                {
                    string cleanAlias = Regex.Replace(alias.ToLowerInvariant(), @"[\s_]+", "");
                    foreach (var kvp in dict)
                    {
                        string cleanKey = Regex.Replace(kvp.Key.ToLowerInvariant(), @"[\s_]+", "");
                        if (cleanKey == cleanAlias && kvp.Value != null)
                        {
                            return kvp.Value.ToString()?.Trim() ?? "";
                        }
                    }
                }
                return "";
            }

            string sku = GetVal("SkuName", "Sku", "Size", "VmSize", "InstanceType");
            string vmName = GetVal("VmName", "VM", "Host", "Hostname", "ServerName");
            string env = GetVal("Environment", "Env", "Tier");
            string cpuStr = GetVal("CPU", "Cores", "vCPU", "vCPUs");
            string ramStr = GetVal("RAM", "Memory", "RamGB", "MemoryGB");

            string osDiskStr = GetVal("OSDisk", "OSDiskGB", "OSDiskSize", "OSStorage", "OSSize");
            string dataDiskStr = GetVal("DataDisk", "DataDiskGB", "DataDiskSize", "DataStorage", "DataSize");
            string storageStr = GetVal("Storage", "Disk", "StorageGB", "DiskGB", "SizeGB");

            string region = GetVal("Region", "Location");
            string os = GetVal("OS", "OperatingSystem", "OSType");
            string sql = GetVal("SqlEdition", "SQL", "SQLEdition", "Database");
            string qtyStr = GetVal("Quantity", "Qty", "Count");

            int.TryParse(cpuStr, out int cpu);
            decimal.TryParse(ramStr, out decimal ram);
            decimal.TryParse(osDiskStr, out decimal osDisk);
            decimal.TryParse(dataDiskStr, out decimal dataDisk);
            decimal.TryParse(storageStr, out decimal storage);

            if (string.IsNullOrWhiteSpace(sku) && cpu <= 0 && ram <= 0) continue;

            rawItems.Add(new InventoryItem
            {
                VmName = string.IsNullOrWhiteSpace(vmName) ? (string.IsNullOrWhiteSpace(sku) ? "onprem-vm" : sku) : vmName,
                Environment = string.IsNullOrWhiteSpace(env) ? "Prod" : env,
                SkuName = sku,
                CpuCores = cpu,
                RamGb = ram,
                OsDiskGb = osDisk,
                DataDiskGb = dataDisk,
                StorageGb = storage,
                Region = string.IsNullOrWhiteSpace(region) ? "eastus" : region,
                RawOs = string.IsNullOrWhiteSpace(os) ? "Linux" : os,
                SqlEdition = sql,
                Quantity = int.TryParse(qtyStr, out int q) && q > 0 ? q : 1
            });
        }
    }

    private void ParseExcel(Stream stream)
    {
        using var workbook = new XLWorkbook(stream);
        var worksheet = workbook.Worksheets.FirstOrDefault();
        if (worksheet == null) return;

        var firstRow = worksheet.FirstRowUsed();
        if (firstRow == null) return;

        var headerMap = new Dictionary<string, int>();
        foreach (var cell in firstRow.CellsUsed())
        {
            string clean = Regex.Replace(cell.GetString().Trim().ToLowerInvariant(), @"[\s_]+", "");
            if (!string.IsNullOrEmpty(clean) && !headerMap.ContainsKey(clean))
            {
                headerMap[clean] = cell.Address.ColumnNumber;
            }
        }

        string GetExcelVal(IXLRow row, params string[] aliases)
        {
            foreach (var alias in aliases)
            {
                string clean = Regex.Replace(alias.ToLowerInvariant(), @"[\s_]+", "");
                if (headerMap.TryGetValue(clean, out int colIndex))
                {
                    return row.Cell(colIndex).GetString().Trim();
                }
            }
            return "";
        }

        var rows = worksheet.RowsUsed().Skip(1);
        foreach (var row in rows)
        {
            string sku = GetExcelVal(row, "SkuName", "Sku", "Size", "VmSize", "InstanceType");
            string vmName = GetExcelVal(row, "VmName", "VM", "Host", "Hostname", "ServerName");
            string env = GetExcelVal(row, "Environment", "Env", "Tier");
            string cpuStr = GetExcelVal(row, "CPU", "Cores", "vCPU", "vCPUs");
            string ramStr = GetExcelVal(row, "RAM", "Memory", "RamGB", "MemoryGB");

            string osDiskStr = GetExcelVal(row, "OSDisk", "OSDiskGB", "OSDiskSize", "OSStorage", "OSSize");
            string dataDiskStr = GetExcelVal(row, "DataDisk", "DataDiskGB", "DataDiskSize", "DataStorage", "DataSize");
            string storageStr = GetExcelVal(row, "Storage", "Disk", "StorageGB", "DiskGB", "SizeGB");

            string region = GetExcelVal(row, "Region", "Location");
            string os = GetExcelVal(row, "OS", "OperatingSystem", "OSType");
            string sql = GetExcelVal(row, "SqlEdition", "SQL", "SQLEdition", "Database");
            string qtyStr = GetExcelVal(row, "Quantity", "Qty", "Count");

            int.TryParse(cpuStr, out int cpu);
            decimal.TryParse(ramStr, out decimal ram);
            decimal.TryParse(osDiskStr, out decimal osDisk);
            decimal.TryParse(dataDiskStr, out decimal dataDisk);
            decimal.TryParse(storageStr, out decimal storage);

            if (string.IsNullOrWhiteSpace(sku) && cpu <= 0 && ram <= 0) continue;

            rawItems.Add(new InventoryItem
            {
                VmName = string.IsNullOrWhiteSpace(vmName) ? (string.IsNullOrWhiteSpace(sku) ? "onprem-vm" : sku) : vmName,
                Environment = string.IsNullOrWhiteSpace(env) ? "Prod" : env,
                SkuName = sku,
                CpuCores = cpu,
                RamGb = ram,
                OsDiskGb = osDisk,
                DataDiskGb = dataDisk,
                StorageGb = storage,
                Region = string.IsNullOrWhiteSpace(region) ? "eastus" : region,
                RawOs = string.IsNullOrWhiteSpace(os) ? "Linux" : os,
                SqlEdition = sql,
                Quantity = int.TryParse(qtyStr, out int q) && q > 0 ? q : 1
            });
        }
    }

    private async Task RunEstimation()
    {
        isLoading = true;
        statusMessage = $"Fetching Azure pricing and calculating at {monthlyOperatingHours} hrs/mo...";
        results.Clear();

        foreach (var item in rawItems)
        {
            var res = await PricingService.CalculateItemCostAsync(item, selectedProcessor, enableOsAhb, enableSqlAhb, monthlyOperatingHours);
            results.Add(res);
        }

        isLoading = false;
        statusMessage = $"Completed estimates for {results.Count} items.";
    }

    private async Task ExportToExcel()
    {
        try
        {
            if (results.Count == 0)
            {
                statusMessage = "Error: No results to export. Please calculate an estimate first.";
                return;
            }

            using var workbook = new XLWorkbook();
            int vmCount = results.Sum(r => r.Quantity);
            decimal totalVmStorage = results.Sum(r => r.SourceOsDiskGb + r.SourceDataDiskGb);
            
            // ==========================================
            // Sheet 1: Executive Summary
            // ==========================================
            var summarySheet = workbook.Worksheets.Add("Cost Summary");
            summarySheet.Cell(1, 1).Value = "Sl No";
            summarySheet.Cell(1, 2).Value = "Service Name";
            summarySheet.Cell(1, 3).Value = "PAYG";
            summarySheet.Cell(1, 4).Value = "1 YR RI Model";
            summarySheet.Cell(1, 5).Value = "3 YR RI Model";
            summarySheet.Cell(1, 6).Value = "Remarks";

            var summaryHeaderRange = summarySheet.Range(1, 1, 1, 6);
            summaryHeaderRange.Style.Font.Bold = true;
            summaryHeaderRange.Style.Fill.BackgroundColor = XLColor.DarkSlateGray;
            summaryHeaderRange.Style.Font.FontColor = XLColor.White;

            int rowCounter = 2;
            summarySheet.Cell(rowCounter, 1).Value = 1;
            summarySheet.Cell(rowCounter, 2).Value = "Virtual Machines (Compute)";
            summarySheet.Cell(rowCounter, 3).Value = totalComputePayg;
            summarySheet.Cell(rowCounter, 4).Value = totalCompute1Yr;
            summarySheet.Cell(rowCounter, 5).Value = totalCompute3Yr;
            summarySheet.Cell(rowCounter++, 6).Value = $"Scaled to {monthlyOperatingHours} hrs/mo";

            summarySheet.Cell(rowCounter, 1).Value = 2;
            summarySheet.Cell(rowCounter, 2).Value = "Managed Disks (OS & Data)";
            summarySheet.Cell(rowCounter, 3).Value = totalStorage;
            summarySheet.Cell(rowCounter, 4).Value = totalStorage;
            summarySheet.Cell(rowCounter, 5).Value = totalStorage;
            summarySheet.Cell(rowCounter++, 6).Value = "Fixed monthly rate";

            summarySheet.Cell(rowCounter, 1).Value = 3;
            summarySheet.Cell(rowCounter, 2).Value = "OS Licensing";
            summarySheet.Cell(rowCounter, 3).Value = totalOsLicense;
            summarySheet.Cell(rowCounter, 4).Value = totalOsLicense;
            summarySheet.Cell(rowCounter, 5).Value = totalOsLicense;
            summarySheet.Cell(rowCounter++, 6).Value = enableOsAhb ? "AHB Applied ($0)" : "PAYG license";

            summarySheet.Cell(rowCounter, 1).Value = 4;
            summarySheet.Cell(rowCounter, 2).Value = "Database Licensing (SQL Server)";
            summarySheet.Cell(rowCounter, 3).Value = totalSqlLicense;
            summarySheet.Cell(rowCounter, 4).Value = totalSqlLicense;
            summarySheet.Cell(rowCounter, 5).Value = totalSqlLicense;
            summarySheet.Cell(rowCounter++, 6).Value = enableSqlAhb ? "AHB Applied ($0)" : "PAYG license";

            if (lzConfig.MasterEnable && totalLandingZoneMonthly > 0)
            {
                summarySheet.Cell(rowCounter, 1).Value = 5;
                summarySheet.Cell(rowCounter, 2).Value = "Landing zone resources";
                summarySheet.Cell(rowCounter, 3).Value = totalLandingZoneMonthly;
                summarySheet.Cell(rowCounter, 4).Value = totalLandingZoneMonthly;
                summarySheet.Cell(rowCounter, 5).Value = totalLandingZoneMonthly;
                summarySheet.Cell(rowCounter++, 6).Value = "Consolidated shared hub services (See Sheet 2)";
            }

            summarySheet.Cell(rowCounter, 1).Value = "";
            summarySheet.Cell(rowCounter, 2).Value = "Total Cost";
            summarySheet.Cell(rowCounter, 3).Value = grandTotalPayg;
            summarySheet.Cell(rowCounter, 4).Value = grandTotal1Yr;
            summarySheet.Cell(rowCounter, 5).Value = grandTotal3Yr;
            summarySheet.Cell(rowCounter, 6).Value = "";

            var totalRowRange = summarySheet.Range(rowCounter, 1, rowCounter, 6);
            totalRowRange.Style.Font.Bold = true;
            totalRowRange.Style.Fill.BackgroundColor = XLColor.LightGray;

            for (int r = 2; r <= rowCounter; r++)
            {
                summarySheet.Cell(r, 3).Style.NumberFormat.Format = "$#,##0.00";
                summarySheet.Cell(r, 4).Style.NumberFormat.Format = "$#,##0.00";
                summarySheet.Cell(r, 5).Style.NumberFormat.Format = "$#,##0.00";
            }
            summarySheet.Columns().AdjustToContents();

            // ==========================================
            // Sheet 2: Dedicated Landing Zone Components Sheet
            // ==========================================
            var lzSheet = workbook.Worksheets.Add("landing zone Components");
            lzSheet.Cell(1, 1).Value = "Sl No";
            lzSheet.Cell(1, 2).Value = "Component Name";
            lzSheet.Cell(1, 3).Value = "Configured Tier / SKU";
            lzSheet.Cell(1, 4).Value = "Units / Capacity";
            lzSheet.Cell(1, 5).Value = "Monthly Cost (USD)";
            lzSheet.Cell(1, 6).Value = "Description / Remarks";

            var lzHeaderRange = lzSheet.Range(1, 1, 1, 6);
            lzHeaderRange.Style.Font.Bold = true;
            lzHeaderRange.Style.Fill.BackgroundColor = XLColor.DarkSlateGray;
            lzHeaderRange.Style.Font.FontColor = XLColor.White;

            int lzRowIdx = 2;
            if (lzConfig.MasterEnable)
            {
                void AddLzRow(string name, string tier, string units, decimal cost, string remarks)
                {
                    lzSheet.Cell(lzRowIdx, 1).Value = lzRowIdx - 1;
                    lzSheet.Cell(lzRowIdx, 2).Value = name;
                    lzSheet.Cell(lzRowIdx, 3).Value = tier;
                    lzSheet.Cell(lzRowIdx, 4).Value = units;
                    lzSheet.Cell(lzRowIdx, 5).Value = cost;
                    lzSheet.Cell(lzRowIdx++, 6).Value = remarks;
                }

                if (lzConfig.EnableFirewall)
                {
                    var fw = PricingService.CalculateFirewallCost(lzConfig.FirewallTier);
                    AddLzRow("Azure Firewall", lzConfig.FirewallTier, "1 Deployment", fw.MonthlyCost, fw.Remarks);
                }
                if (lzConfig.EnableVpnGateway)
                {
                    var vpn = PricingService.CalculateVpnGatewayCost(lzConfig.VpnSku);
                    AddLzRow("Azure VPN Gateway", lzConfig.VpnSku, "1 Gateway", vpn.MonthlyCost, vpn.Remarks);
                }
                if (lzConfig.EnableAppGateway)
                {
                    var appGw = PricingService.CalculateAppGatewayCost(lzConfig.AppGwTier, lzConfig.AppGwCapacityUnits);
                    AddLzRow("Application Gateway v2", lzConfig.AppGwTier, $"{lzConfig.AppGwCapacityUnits} Capacity Unit(s)", appGw.MonthlyCost, appGw.Remarks);
                }
                if (lzConfig.EnableBastion)
                {
                    var bastion = PricingService.CalculateBastionCost(lzConfig.BastionTier);
                    AddLzRow("Azure Bastion", lzConfig.BastionTier, "1 Host Service", bastion.MonthlyCost, bastion.Remarks);
                }
                if (lzConfig.EnableBackup)
                {
                    var backup = PricingService.CalculateBackupCost(vmCount, totalVmStorage);
                    AddLzRow("Azure Backup", "RSV / Protected Instances", $"{vmCount} VM(s) ({totalVmStorage:N0} GB)", backup.MonthlyCost, backup.Remarks);
                }
                if (lzConfig.EnableDefender)
                {
                    var def = PricingService.CalculateDefenderCost(vmCount, lzConfig.DefenderPlan);
                    AddLzRow("Microsoft Defender for Cloud", lzConfig.DefenderPlan, $"{vmCount} Server Instance(s)", def.MonthlyCost, def.Remarks);
                }
                if (lzConfig.EnableKeyVault)
                {
                    var kv = PricingService.CalculateKeyVaultCost(lzConfig.KeyVaultTier);
                    AddLzRow("Azure Key Vault", lzConfig.KeyVaultTier, "1 Vault Resource", kv.MonthlyCost, kv.Remarks);
                }
                if (lzConfig.EnableDdos)
                {
                    var ddos = PricingService.CalculateDdosCost();
                    AddLzRow("Azure DDoS Protection", "Network Protection", "1 Plan (up to 100 IPs)", ddos.MonthlyCost, ddos.Remarks);
                }
                if (lzConfig.EnablePublicIps)
                {
                    var pip = PricingService.CalculatePublicIpCost(lzConfig.PublicIpCount);
                    AddLzRow("Public IP Addresses", "Standard Static IPv4", $"{lzConfig.PublicIpCount} IP(s)", pip.MonthlyCost, pip.Remarks);
                }
                if (lzConfig.EnablePrivateEndpoints)
                {
                    var pe = PricingService.CalculatePrivateEndpointCost(lzConfig.PrivateEndpointCount);
                    AddLzRow("Private Endpoints", "Standard Private Link", $"{lzConfig.PrivateEndpointCount} Endpoint(s)", pe.MonthlyCost, pe.Remarks);
                }
                if (lzConfig.EnableNatGateway)
                {
                    var nat = PricingService.CalculateNatGatewayCost(lzConfig.NatGatewayCount);
                    AddLzRow("NAT Gateway", "Standard NAT", $"{lzConfig.NatGatewayCount} Gateway(s)", nat.MonthlyCost, nat.Remarks);
                }
                if (lzConfig.EnableDnsResolver)
                {
                    var dns = PricingService.CalculateDnsResolverCost();
                    AddLzRow("DNS Private Resolver", "Standard Endpoints", "1 Inbound + 1 Outbound", dns.MonthlyCost, dns.Remarks);
                }
                if (lzConfig.EnableAsr)
                {
                    var asr = PricingService.CalculateAsrCost(vmCount);
                    AddLzRow("Azure Site Recovery (ASR)", "DR Replicated Instances", $"{vmCount} Replicated VM(s)", asr.MonthlyCost, asr.Remarks);
                }
                if (lzConfig.EnableMonitor)
                {
                    var mon = PricingService.CalculateMonitorCost(lzConfig.MonitorDataIngestionGb);
                    AddLzRow("Azure Monitor (Log Analytics)", "Pay-As-You-Go Ingestion", $"{lzConfig.MonitorDataIngestionGb:N0} GB / Month", mon.MonthlyCost, mon.Remarks);
                }
            }

            if (lzRowIdx == 2)
            {
                lzSheet.Cell(2, 2).Value = "No landing zone components selected";
                lzSheet.Cell(2, 5).Value = 0m;
                lzRowIdx = 3;
            }

            lzSheet.Cell(lzRowIdx, 1).Value = "";
            lzSheet.Cell(lzRowIdx, 2).Value = "Total Landing Zone Cost";
            lzSheet.Cell(lzRowIdx, 3).Value = "";
            lzSheet.Cell(lzRowIdx, 4).Value = "";
            lzSheet.Cell(lzRowIdx, 5).Value = totalLandingZoneMonthly;
            lzSheet.Cell(lzRowIdx, 6).Value = "";

            var lzTotalRange = lzSheet.Range(lzRowIdx, 1, lzRowIdx, 6);
            lzTotalRange.Style.Font.Bold = true;
            lzTotalRange.Style.Fill.BackgroundColor = XLColor.LightGray;

            for (int r = 2; r <= lzRowIdx; r++)
            {
                lzSheet.Cell(r, 5).Style.NumberFormat.Format = "$#,##0.00";
            }
            lzSheet.Columns().AdjustToContents();

            // ==========================================
            // Sheet 3: Detailed Inventory
            // ==========================================
            var worksheet = workbook.Worksheets.Add("VM Inventory Details");
            string[] headers = new[]
            {
                "VM / Hostname", "Environment", "Source CPU", "Source RAM (GB)",
                "Azure SKU", "Azure CPU", "Azure RAM (GB)", "Region", "OS", "SQL Edition", "Quantity",
                $"Compute PAYG ({monthlyOperatingHours} hrs)", "Compute 1-Yr RI / Mo", "Compute 3-Yr RI / Mo",
                "OS disk sku", "OS disk cost", "Data disk sku", "Data disk cost", "Total disk cost", 
                "OS Lic / Mo", "SQL Lic / Mo",
                "Total PAYG / Mo", "Total 1-Yr / Mo", "Total 3-Yr / Mo"
            };

            for (int c = 0; c < headers.Length; c++)
            {
                var cell = worksheet.Cell(1, c + 1);
                cell.Value = headers[c];
                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.DarkSlateGray;
                cell.Style.Font.FontColor = XLColor.White;
            }

            int rowIdx = 2;
            foreach (var r in results)
            {
                decimal totalDisk = r.OsDiskMonthlyCost + r.DataDiskMonthlyCost;

                worksheet.Cell(rowIdx, 1).Value = r.VmName;
                worksheet.Cell(rowIdx, 2).Value = r.Environment;
                worksheet.Cell(rowIdx, 3).Value = r.SourceCpu > 0 ? r.SourceCpu.ToString() : "-";
                worksheet.Cell(rowIdx, 4).Value = r.SourceRamGb > 0 ? r.SourceRamGb.ToString() : "-";
                worksheet.Cell(rowIdx, 5).Value = r.SkuName;
                worksheet.Cell(rowIdx, 6).Value = r.TargetCpu;
                worksheet.Cell(rowIdx, 7).Value = r.TargetRamGb;
                worksheet.Cell(rowIdx, 8).Value = r.Region;
                worksheet.Cell(rowIdx, 9).Value = r.DetectedOs;
                worksheet.Cell(rowIdx, 10).Value = r.SqlEdition;
                worksheet.Cell(rowIdx, 11).Value = r.Quantity;

                worksheet.Cell(rowIdx, 12).Value = r.ComputePaygMonthly;
                worksheet.Cell(rowIdx, 13).Value = r.ComputeReserved1YrMonthly;
                worksheet.Cell(rowIdx, 14).Value = r.ComputeReserved3YrMonthly;
                
                worksheet.Cell(rowIdx, 15).Value = r.RecommendedOsDisk;
                worksheet.Cell(rowIdx, 16).Value = r.OsDiskMonthlyCost;
                worksheet.Cell(rowIdx, 17).Value = r.RecommendedDataDisk;
                worksheet.Cell(rowIdx, 18).Value = r.DataDiskMonthlyCost;
                worksheet.Cell(rowIdx, 19).Value = totalDisk;

                worksheet.Cell(rowIdx, 20).Value = r.OsLicenseMonthlyCost;
                worksheet.Cell(rowIdx, 21).Value = r.SqlLicenseMonthlyCost;
                worksheet.Cell(rowIdx, 22).Value = r.TotalPaygMonthly;
                worksheet.Cell(rowIdx, 23).Value = r.TotalReserved1YrMonthly;
                worksheet.Cell(rowIdx, 24).Value = r.TotalReserved3YrMonthly;

                int[] currencyCols = new[] { 12, 13, 14, 16, 18, 19, 20, 21, 22, 23, 24 };
                foreach (int col in currencyCols)
                {
                    worksheet.Cell(rowIdx, col).Style.NumberFormat.Format = "$#,##0.00";
                }

                rowIdx++;
            }

            worksheet.Columns().AdjustToContents();

            // ==========================================
            // Sheet 4: Considerations & Assumptions (Kept at the end)
            // ==========================================
            var notesSheet = workbook.Worksheets.Add("Considerations & Assumptions");
            notesSheet.Cell(1, 1).Value = "Sl No";
            notesSheet.Cell(1, 2).Value = "Consideration / Assumption";

            var notesHeaderRange = notesSheet.Range(1, 1, 1, 2);
            notesHeaderRange.Style.Font.Bold = true;
            notesHeaderRange.Style.Fill.BackgroundColor = XLColor.DarkSlateGray;
            notesHeaderRange.Style.Font.FontColor = XLColor.White;

            string[] excelAssumptions = new[]
            {
                $"PAYG compute and software licensing are calculated based on {monthlyOperatingHours} operating hours/month.",
                "1-Year and 3-Year Reserved Instances (RI) apply to VM compute infrastructure only and require continuous commitments.",
                "Storage mapping policy: Non-production environments (Dev/UAT/Test) map to Standard SSD (E-series); Production environments map to Premium SSD (P-series). Disks are billed flat monthly regardless of VM state.",
                enableOsAhb ? "Azure Hybrid Benefit (AHB) for OS is enabled ($0.00 license charge applied)." : "Windows/OS licensing reflects standard PAYG core-based license fees.",
                enableSqlAhb ? "Azure Hybrid Benefit (AHB) for SQL Server is enabled ($0.00 license charge applied)." : "Database licensing reflects standard Azure SQL core licensing with a minimum 4-core billing rule applied.",
                "SKU Selection engine evaluates candidate VMs dynamically across D-series, E-series, and M-series families, prioritizing the candidate with the lowest overall monthly cost (Compute + Licensing + Storage).",
                lzConfig.MasterEnable ? "Landing Zone shared hub infrastructure components (Firewall, VPN Gateway, Application Gateway, Bastion, Backup, Defender, Key Vault, DDoS, Public IPs, Private Endpoints, NAT Gateway, DNS Resolver, ASR, and Monitor) are consolidated in the Executive Summary and itemized in the dedicated sheet as fixed monthly deployments." : "Landing Zone shared services are excluded from this estimation."
            };

            for (int i = 0; i < excelAssumptions.Length; i++)
            {
                notesSheet.Cell(i + 2, 1).Value = i + 1;
                notesSheet.Cell(i + 2, 2).Value = excelAssumptions[i];
            }

            notesSheet.Columns().AdjustToContents();

            using var memoryStream = new MemoryStream();
            workbook.SaveAs(memoryStream);
            string base64 = Convert.ToBase64String(memoryStream.ToArray());

            await JS.InvokeVoidAsync("saveAsFile", "Azure_Cost_Estimate.xlsx", base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            statusMessage = "Excel file exported successfully.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error exporting Excel: {ex.Message}";
        }
    }

    private async Task ExportToCsv()
    {
        try
        {
            if (results.Count == 0)
            {
                statusMessage = "Error: No results to export. Please calculate an estimate first.";
                return;
            }

            int vmCount = results.Sum(r => r.Quantity);
            decimal totalVmStorage = results.Sum(r => r.SourceOsDiskGb + r.SourceDataDiskGb);

            var sb = new StringBuilder();
            sb.AppendLine("=== EXECUTIVE SUMMARY ===");
            sb.AppendLine("Sl No,Service Name,PAYG,1 YR RI Model,3 YR RI Model,Remarks");
            sb.AppendLine($"1,Virtual Machines (Compute),{totalComputePayg:F2},{totalCompute1Yr:F2},{totalCompute3Yr:F2},Scaled to {monthlyOperatingHours} hrs/mo");
            sb.AppendLine($"2,Managed Disks (OS & Data),{totalStorage:F2},{totalStorage:F2},{totalStorage:F2},Fixed monthly rate");
            sb.AppendLine($"3,OS Licensing,{totalOsLicense:F2},{totalOsLicense:F2},{totalOsLicense:F2},{(enableOsAhb ? "AHB Applied ($0)" : "PAYG license")}");
            sb.AppendLine($"4,Database Licensing (SQL Server),{totalSqlLicense:F2},{totalSqlLicense:F2},{totalSqlLicense:F2},{(enableSqlAhb ? "AHB Applied ($0)" : "PAYG license")}");

            if (lzConfig.MasterEnable && totalLandingZoneMonthly > 0)
            {
                sb.AppendLine($"5,Landing zone resources,{totalLandingZoneMonthly:F2},{totalLandingZoneMonthly:F2},{totalLandingZoneMonthly:F2},Consolidated shared hub services");
            }

            sb.AppendLine($",Total Cost,{grandTotalPayg:F2},{grandTotal1Yr:F2},{grandTotal3Yr:F2},");
            sb.AppendLine();

            // Landing Zone Components Section
            sb.AppendLine("=== LANDING ZONE COMPONENTS ===");
            sb.AppendLine("Sl No,Component Name,Configured Tier / SKU,Units / Capacity,Monthly Cost (USD),Description / Remarks");
            int lzCsvIdx = 1;
            if (lzConfig.MasterEnable)
            {
                void AddLzCsv(string name, string tier, string units, decimal cost, string remarks)
                {
                    sb.AppendLine($"{lzCsvIdx++},\"{name}\",\"{tier}\",\"{units}\",{cost:F2},\"{remarks}\"");
                }

                if (lzConfig.EnableFirewall)
                {
                    var fw = PricingService.CalculateFirewallCost(lzConfig.FirewallTier);
                    AddLzCsv("Azure Firewall", lzConfig.FirewallTier, "1 Deployment", fw.MonthlyCost, fw.Remarks);
                }
                if (lzConfig.EnableVpnGateway)
                {
                    var vpn = PricingService.CalculateVpnGatewayCost(lzConfig.VpnSku);
                    AddLzCsv("Azure VPN Gateway", lzConfig.VpnSku, "1 Gateway", vpn.MonthlyCost, vpn.Remarks);
                }
                if (lzConfig.EnableAppGateway)
                {
                    var appGw = PricingService.CalculateAppGatewayCost(lzConfig.AppGwTier, lzConfig.AppGwCapacityUnits);
                    AddLzCsv("Application Gateway v2", lzConfig.AppGwTier, $"{lzConfig.AppGwCapacityUnits} Capacity Unit(s)", appGw.MonthlyCost, appGw.Remarks);
                }
                if (lzConfig.EnableBastion)
                {
                    var bastion = PricingService.CalculateBastionCost(lzConfig.BastionTier);
                    AddLzCsv("Azure Bastion", lzConfig.BastionTier, "1 Host Service", bastion.MonthlyCost, bastion.Remarks);
                }
                if (lzConfig.EnableBackup)
                {
                    var backup = PricingService.CalculateBackupCost(vmCount, totalVmStorage);
                    AddLzCsv("Azure Backup", "RSV / Protected Instances", $"{vmCount} VM(s) ({totalVmStorage:N0} GB)", backup.MonthlyCost, backup.Remarks);
                }
                if (lzConfig.EnableDefender)
                {
                    var def = PricingService.CalculateDefenderCost(vmCount, lzConfig.DefenderPlan);
                    AddLzCsv("Microsoft Defender for Cloud", lzConfig.DefenderPlan, $"{vmCount} Server Instance(s)", def.MonthlyCost, def.Remarks);
                }
                if (lzConfig.EnableKeyVault)
                {
                    var kv = PricingService.CalculateKeyVaultCost(lzConfig.KeyVaultTier);
                    AddLzCsv("Azure Key Vault", lzConfig.KeyVaultTier, "1 Vault Resource", kv.MonthlyCost, kv.Remarks);
                }
                if (lzConfig.EnableDdos)
                {
                    var ddos = PricingService.CalculateDdosCost();
                    AddLzCsv("Azure DDoS Protection", "Network Protection", "1 Plan (up to 100 IPs)", ddos.MonthlyCost, ddos.Remarks);
                }
                if (lzConfig.EnablePublicIps)
                {
                    var pip = PricingService.CalculatePublicIpCost(lzConfig.PublicIpCount);
                    AddLzCsv("Public IP Addresses", "Standard Static IPv4", $"{lzConfig.PublicIpCount} IP(s)", pip.MonthlyCost, pip.Remarks);
                }
                if (lzConfig.EnablePrivateEndpoints)
                {
                    var pe = PricingService.CalculatePrivateEndpointCost(lzConfig.PrivateEndpointCount);
                    AddLzCsv("Private Endpoints", "Standard Private Link", $"{lzConfig.PrivateEndpointCount} Endpoint(s)", pe.MonthlyCost, pe.Remarks);
                }
                if (lzConfig.EnableNatGateway)
                {
                    var nat = PricingService.CalculateNatGatewayCost(lzConfig.NatGatewayCount);
                    AddLzCsv("NAT Gateway", "Standard NAT", $"{lzConfig.NatGatewayCount} Gateway(s)", nat.MonthlyCost, nat.Remarks);
                }
                if (lzConfig.EnableDnsResolver)
                {
                    var dns = PricingService.CalculateDnsResolverCost();
                    AddLzCsv("DNS Private Resolver", "Standard Endpoints", "1 Inbound + 1 Outbound", dns.MonthlyCost, dns.Remarks);
                }
                if (lzConfig.EnableAsr)
                {
                    var asr = PricingService.CalculateAsrCost(vmCount);
                    AddLzCsv("Azure Site Recovery (ASR)", "DR Replicated Instances", $"{vmCount} Replicated VM(s)", asr.MonthlyCost, asr.Remarks);
                }
                if (lzConfig.EnableMonitor)
                {
                    var mon = PricingService.CalculateMonitorCost(lzConfig.MonitorDataIngestionGb);
                    AddLzCsv("Azure Monitor (Log Analytics)", "Pay-As-You-Go Ingestion", $"{lzConfig.MonitorDataIngestionGb:N0} GB / Month", mon.MonthlyCost, mon.Remarks);
                }
            }
            sb.AppendLine($",Total Landing Zone Cost,,,{totalLandingZoneMonthly:F2},");
            sb.AppendLine();

            // Inventory Details Section
            sb.AppendLine("=== INVENTORY DETAILS ===");
            sb.AppendLine($"VM / Hostname,Environment,Source CPU,Source RAM (GB),Azure SKU,Azure CPU,Azure RAM (GB),Region,OS,SQL Edition,Quantity,Compute PAYG ({monthlyOperatingHours} hrs),Compute 1-Yr RI / Mo,Compute 3-Yr RI / Mo,OS disk sku,OS disk cost,Data disk sku,Data disk cost,Total disk cost,OS Lic / Mo,SQL Lic / Mo,Total PAYG / Mo,Total 1-Yr / Mo,Total 3-Yr / Mo");

            foreach (var r in results)
            {
                string srcCpu = r.SourceCpu > 0 ? r.SourceCpu.ToString() : "-";
                string srcRam = r.SourceRamGb > 0 ? r.SourceRamGb.ToString() : "-";
                decimal totalDisk = r.OsDiskMonthlyCost + r.DataDiskMonthlyCost;

                sb.AppendLine($"\"{r.VmName}\",\"{r.Environment}\",\"{srcCpu}\",\"{srcRam}\",\"{r.SkuName}\",{r.TargetCpu},{r.TargetRamGb},\"{r.Region}\",\"{r.DetectedOs}\",\"{r.SqlEdition}\",{r.Quantity},{r.ComputePaygMonthly:F2},{r.ComputeReserved1YrMonthly:F2},{r.ComputeReserved3YrMonthly:F2},\"{r.RecommendedOsDisk}\",{r.OsDiskMonthlyCost:F2},\"{r.RecommendedDataDisk}\",{r.DataDiskMonthlyCost:F2},{totalDisk:F2},{r.OsLicenseMonthlyCost:F2},{r.SqlLicenseMonthlyCost:F2},{r.TotalPaygMonthly:F2},{r.TotalReserved1YrMonthly:F2},{r.TotalReserved3YrMonthly:F2}");
            }
            sb.AppendLine();

            // Considerations & Assumptions Section
            sb.AppendLine("=== CONSIDERATIONS & ASSUMPTIONS ===");
            sb.AppendLine($"1. PAYG compute and licensing calculated based on {monthlyOperatingHours} operating hours/month.");
            sb.AppendLine("2. 1-Year and 3-Year Reserved Instances (RI) apply to VM compute infrastructure only.");
            sb.AppendLine("3. Dev/UAT workloads map to Standard SSD (E-series); Production workloads map to Premium SSD (P-series). Disks are billed flat monthly.");
            sb.AppendLine($"4. Windows OS AHB: {(enableOsAhb ? "Enabled ($0.00)" : "Disabled (PAYG rate)")}; SQL AHB: {(enableSqlAhb ? "Enabled ($0.00)" : "Disabled (PAYG rate with 4-core minimum rule)")}.");
            sb.AppendLine("5. SKUs evaluated dynamically across D, E, and M series based on lowest overall total cost.");
            sb.AppendLine($"6. Shared Services: {(lzConfig.MasterEnable ? "Landing Zone resources consolidated in summary and itemized in detail." : "Excluded from calculation.")}");

            string base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
            await JS.InvokeVoidAsync("saveAsFile", "Azure_Cost_Estimate.csv", base64, "text/csv");
            statusMessage = "CSV file exported successfully.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error exporting CSV: {ex.Message}";
        }
    }
}